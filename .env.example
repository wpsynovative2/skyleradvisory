# Google Apps Script web app URL (see google-apps-script/README.md).
# Deploy Code.gs as a web app, then paste the /exec URL here.
GOOGLE_SCRIPT_URL=

# Optional shared secret. Must match the TOKEN script property in Apps Script.
GOOGLE_SCRIPT_TOKEN=

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# Register the site's domain, pick "Score based (v3)", and paste both keys.
# The site key is public and is baked into the browser bundle at build time;
# the secret key stays on the server. Leave both blank to disable the check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Minimum score to accept, 0.0 (bot) to 1.0 (human). Defaults to 0.5.
RECAPTCHA_MIN_SCORE=
